@page "/customers"
@using WebWorkshop.Models
@inject WebWorkshop.Services.GraphQLClient Gql

<h1>Заказчики</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div style="color:red">@_error</div>
}

<div class="card p-3 mb-3">
    <h5>Добавить заказчика</h5>

    <div class="row g-2 align-items-center">
        <div class="col-md-3">
            <input class="form-control" placeholder="ФИО" @bind="_newFullName" />
        </div>
        <div class="col-md-3">
            <input class="form-control" placeholder="Email" @bind="_newEmail" />
        </div>
        <div class="col-md-2">
            <input class="form-control" placeholder="Телефон" @bind="_newPhone" />
        </div>
        <div class="col-md-3">
            <input class="form-control" placeholder="Паспорт/ID" @bind="_newDoc" />
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary"
                    @onclick="CreateCustomer"
                    disabled="@(!_canCreateCustomer || _busy)">
                +
            </button>
        </div>
    </div>

    @if (!_canCreateCustomer)
    {
        <small class="text-muted">Заполните все поля, чтобы добавить заказчика.</small>
    }
</div>

@if (_customers is null)
{
    <p>Загрузка...</p>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div>
            <b>Страница:</b> @_page / @_totalPages
            <span class="text-muted"> (всего: @_customers.Count)</span>
        </div>

        <div class="btn-group">
            <button class="btn btn-outline-secondary"
                    @onclick="PrevPage"
                    disabled="@(_page <= 1)">
                Назад
            </button>
            <button class="btn btn-outline-secondary"
                    @onclick="NextPage"
                    disabled="@(_page >= _totalPages)">
                Вперёд
            </button>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>ФИО</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Документ</th>
                <th style="width:280px;">Действия</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in _pagedCustomers)
            {
                var isEdit = _editId == c.Id;

                <tr>
                    <td>@c.Id</td>

                    @if (!isEdit)
                    {
                        <td>@c.FullName</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td>@c.PassportOrIdNumber</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary me-2"
                                    @onclick="() => StartEdit(c)"
                                    disabled="@_busy">
                                Редактировать
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteCustomer(c.Id)"
                                    disabled="@_busy">
                                Удалить
                            </button>
                        </td>
                    }
                    else
                    {
                        <td><input class="form-control form-control-sm" @bind="_editFullName" /></td>
                        <td><input class="form-control form-control-sm" @bind="_editEmail" /></td>
                        <td><input class="form-control form-control-sm" @bind="_editPhone" /></td>
                        <td><input class="form-control form-control-sm" @bind="_editDoc" /></td>
                        <td>
                            <button class="btn btn-sm btn-success me-2"
                                    @onclick="SaveEdit"
                                    disabled="@(!_canSaveCustomerEdit || _busy)">
                                Сохранить
                            </button>
                            <button class="btn btn-sm btn-outline-secondary me-2"
                                    @onclick="CancelEdit"
                                    disabled="@_busy">
                                Отмена
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteCustomer(c.Id)"
                                    disabled="@_busy">
                                Удалить
                            </button>

                            @if (!_canSaveCustomerEdit)
                            {
                                <div><small class="text-muted">Для сохранения заполните все поля.</small></div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CustomerDto>? _customers;
    private string? _error;
    private bool _busy;

    
    private const int PageSize = 3;
    private int _page = 1;

    private int _totalPages => _customers is null || _customers.Count == 0
        ? 1
        : (int)Math.Ceiling(_customers.Count / (double)PageSize);

    private IEnumerable<CustomerDto> _pagedCustomers =>
        _customers is null
            ? Enumerable.Empty<CustomerDto>()
            : _customers.Skip((_page - 1) * PageSize).Take(PageSize);

    
    private string _newFullName = "";
    private string _newEmail = "";
    private string _newPhone = "";
    private string _newDoc = "";

    
    private int? _editId;
    private string _editFullName = "";
    private string _editEmail = "";
    private string _editPhone = "";
    private string _editDoc = "";

    private bool _canCreateCustomer =>
        !string.IsNullOrWhiteSpace(_newFullName) &&
        !string.IsNullOrWhiteSpace(_newEmail) &&
        !string.IsNullOrWhiteSpace(_newPhone) &&
        !string.IsNullOrWhiteSpace(_newDoc);

    private bool _canSaveCustomerEdit =>
        !string.IsNullOrWhiteSpace(_editFullName) &&
        !string.IsNullOrWhiteSpace(_editEmail) &&
        !string.IsNullOrWhiteSpace(_editPhone) &&
        !string.IsNullOrWhiteSpace(_editDoc);

    protected override async Task OnInitializedAsync() => await Load();

    private void PrevPage()
    {
        if (_page > 1) _page--;
        CancelEdit();
    }

    private void NextPage()
    {
        if (_page < _totalPages) _page++;
        CancelEdit();
    }

    private void EnsurePageInRange()
    {
        if (_page > _totalPages) _page = _totalPages;
        if (_page < 1) _page = 1;
    }

    private async Task Load()
    {
        _error = null;

        const string q = "query { customers { id fullName email phone passportOrIdNumber } }";
        try
        {
            var data = await Gql.QueryAsync<CustomersResponse>(q);
            _customers = data.Customers ?? new();
            EnsurePageInRange();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateCustomer()
    {
        if (!_canCreateCustomer) return;

        _error = null;
        _busy = true;

        const string m =
            "mutation($input: CustomerCreateInput!) { createCustomer(input: $input) { ok error data { id } } }";

        try
        {
            var vars = new
            {
                input = new
                {
                    fullName = _newFullName.Trim(),
                    email = _newEmail.Trim(),
                    phone = _newPhone.Trim(),
                    passportOrIdNumber = _newDoc.Trim()
                }
            };

            var res = await Gql.QueryAsync<CreateCustomerResponse>(m, vars);
            if (!res.CreateCustomer.Ok)
            {
                _error = res.CreateCustomer.Error ?? "Ошибка создания";
                return;
            }

            _newFullName = _newEmail = _newPhone = _newDoc = "";
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartEdit(CustomerDto c)
    {
        _error = null;
        _editId = c.Id;

        _editFullName = c.FullName;
        _editEmail = c.Email;
        _editPhone = c.Phone;
        _editDoc = c.PassportOrIdNumber;
    }

    private void CancelEdit()
    {
        _editId = null;
        _editFullName = _editEmail = _editPhone = _editDoc = "";
    }

    private async Task SaveEdit()
    {
        if (_editId is null) return;
        if (!_canSaveCustomerEdit) return;

        _error = null;
        _busy = true;

        const string m =
            "mutation($id: Int!, $input: CustomerUpdateInput!) { updateCustomer(id: $id, input: $input) { ok error data { id } } }";

        try
        {
            var vars = new
            {
                id = _editId.Value,
                input = new
                {
                    fullName = _editFullName.Trim(),
                    email = _editEmail.Trim(),
                    phone = _editPhone.Trim(),
                    passportOrIdNumber = _editDoc.Trim()
                }
            };

            var res = await Gql.QueryAsync<UpdateCustomerResponse>(m, vars);
            if (!res.UpdateCustomer.Ok)
            {
                _error = res.UpdateCustomer.Error ?? "Ошибка сохранения";
                return;
            }

            CancelEdit();
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteCustomer(int id)
    {
        _error = null;
        _busy = true;

        const string m = "mutation($id: Int!) { deleteCustomer(id: $id) { ok error data } }";

        try
        {
            var res = await Gql.QueryAsync<DeleteCustomerResponse>(m, new { id });
            if (!res.DeleteCustomer.Ok)
            {
                _error = res.DeleteCustomer.Error ?? "Ошибка удаления";
                return;
            }

            if (_editId == id) CancelEdit();
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class CustomersResponse
    {
        public List<CustomerDto> Customers { get; set; } = new();
    }

    private sealed class CreateCustomerResponse
    {
        public PayloadCustomer CreateCustomer { get; set; } = new();
    }

    private sealed class UpdateCustomerResponse
    {
        public PayloadCustomer UpdateCustomer { get; set; } = new();
    }

    private sealed class DeleteCustomerResponse
    {
        public PayloadBool DeleteCustomer { get; set; } = new();
    }

    private sealed class PayloadCustomer
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
        public CustomerDto? Data { get; set; }
    }

    private sealed class PayloadBool
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
        public bool Data { get; set; }
    }
}
