@page "/projects"
@using WebWorkshop.Models
@inject WebWorkshop.Services.GraphQLClient Gql

<h1>Проекты</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div style="color:red">@_error</div>
}

@if (_loading)
{
    <p>Загрузка...</p>
}
else if (_projects is not null)
{
    if (_projects.Count == 0)
    {
        <p class="text-muted">Проекты отсутствуют</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Статус</th>
                    <th>CustomerId</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _projects)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>@p.Description</td>
                        <td>@p.Status</td>
                        <td>@p.CustomerId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<ProjectDto>? _projects;

    protected override async Task OnInitializedAsync()
    {
        const string query = @"
query {
  projects {
    id
    name
    description
    status
    customerId
  }
}";

        try
        {
            var data = await Gql.QueryAsync<Response>(query);
            _projects = data.Projects;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class Response
    {
        public List<ProjectDto> Projects { get; set; } = new();
    }
}